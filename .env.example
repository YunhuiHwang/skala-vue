# 이 파일을 .env 로 복사한 뒤 실제 발급받은 키를 넣으세요.
# .env 는 .gitignore 에 포함되어 있어 Git 에 올라가지 않습니다.

# OpenWeatherMap (https://openweathermap.org/api) 무료 API 키
# 브라우저에서 직접 호출 (VITE_ 접두사 → 클라이언트 번들에 포함됨)
VITE_OWM_API_KEY=

# NAVER API HUB (네이버 클라우드 콘솔 > NAVER API HUB > Application, "검색" 선택) 의
# Client ID / Client Secret. 서버 전용이므로 VITE_ 접두사 없음. Vercel 에도 동일하게 등록.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
