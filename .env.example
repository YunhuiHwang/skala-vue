# 이 파일을 .env 로 복사한 뒤 실제 발급받은 키를 넣으세요.
# .env 는 .gitignore 에 포함되어 있어 Git 에 올라가지 않습니다.

# OpenWeatherMap (https://openweathermap.org/api) 무료 API 키
# 브라우저에서 직접 호출 (VITE_ 접두사 → 클라이언트 번들에 포함됨)
VITE_OWM_API_KEY=

# 네이버 검색 API (https://developers.naver.com)
# Application 등록 > 사용 API "검색" 체크 후 발급되는 Client ID / Secret
# 서버리스 함수 api/jeon.js 에서만 사용 → VITE_ 접두사 없이 서버 전용
# (Vercel 에서는 Settings > Environment Variables 에 아래 두 개를 등록)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
